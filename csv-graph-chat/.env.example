# ════════════════════════════════════════════════════════════════════════════════
# IntelliGuard Environment Configuration Template
# ════════════════════════════════════════════════════════════════════════════════

# ── Neo4j Graph Database ──────────────────────────────────────────────────────
# Local Docker: bolt://neo4j:7687  | Cloud (Neo4j Aura): neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=csvgraphdb
NEO4J_DATABASE=neo4j

# ── Apache Kafka Broker ───────────────────────────────────────────────────────
# Local Docker: kafka:9092         | Cloud (Upstash / Confluent): <broker-url>:9092
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=csv-rows

# ── AWS S3 Storage (Optional — uploads stored in S3 bucket if configured) ─────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=

# ── Supabase (PostgreSQL Database — persistent jobs & chat audit logs) ─────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=
